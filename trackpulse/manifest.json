{
  "manifest_version": 3,
  "name": "TrackPulse",
  "version": "2.0.0",
  "description": "Tracking inspector & event generator for ecommerce — Detect CMS, extract data, generate & audit GA4/Meta/TikTok events.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://extensionpay.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["src/licensing/extpay-content.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    },
    "default_title": "TrackPulse"
  },
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/page-context-script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
